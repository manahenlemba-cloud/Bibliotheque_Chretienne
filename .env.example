# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WHATSAPP BUSINESS PLATFORM / CLOUD API CONFIGURATION
# Admin's WhatsApp phone number in international E.164 format (e.g., +243811733778)
WHATSAPP_ADMIN_NUMBER="+243811733778"

# Meta WhatsApp Cloud API Access Token (Permanent or System User Token)
WHATSAPP_ACCESS_TOKEN=""

# Meta WhatsApp Phone Number ID (from WhatsApp App Dashboard)
WHATSAPP_PHONE_NUMBER_ID=""

# Meta WhatsApp Business Account ID (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# Webhook verification token configured in Meta App Dashboard
WHATSAPP_VERIFY_TOKEN="derniereheure_webhook_token"

# GOOGLE DRIVE OAUTH 2.0 CONFIGURATION
# Official library Google Drive target account
GOOGLE_DRIVE_TARGET_ACCOUNT="bibliothequechretien@gmail.com"
# Optional server-side persisted Google Drive Access Token
GOOGLE_DRIVE_ACCESS_TOKEN=""
